---
layout: layouts/base.njk
pagination:
  data: collections.topics
  size: 1
  alias: topic
permalink: "/blog/tags/{{ topic | slugTag }}/"
eleventyComputed:
  title: "Thema: {{ topic }}"
---
{%- set activeTopic = topic %}
<header class="page-head wrap">
  <span class="label">Blog · Thema</span>
  <h1 class="display">{{ topic }}</h1>
</header>
<section class="wrap blog-list" style="padding-bottom:clamp(4rem,8vw,7rem)">
  {% include "partials/topic-filter.njk" %}
  <div class="cards">
    {%- for post in collections[topic] | reverse %}
    {%- set feature = false %}
    {% include "partials/post-card.njk" %}
    {%- endfor %}
  </div>
</section>
