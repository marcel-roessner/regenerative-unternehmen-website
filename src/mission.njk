        <img src="/assets/img/fotos/baum-wurzeln-waldboden.webp" srcset="/assets/img/fotos/baum-wurzeln-waldboden-720.webp 720w, /assets/img/fotos/baum-wurzeln-waldboden.webp 1600w" sizes="(max-width: 900px) 100vw, 60vw" alt="Alter Baum, dessen mächtige Wurzeln sich weit über den Waldboden ausbreiten" width="1600" height="900">
