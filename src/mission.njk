    <div>
      <figure class="photo">
        <img src="/assets/img/fotos/haende-pflanzen-setzling.webp" srcset="/assets/img/fotos/haende-pflanzen-setzling-720.webp 720w, /assets/img/fotos/haende-pflanzen-setzling.webp 1600w" sizes="(max-width: 900px) 100vw, 60vw" alt="Zwei Hände setzen einen kleinen Setzling in dunkle Erde" width="1600" height="900">
