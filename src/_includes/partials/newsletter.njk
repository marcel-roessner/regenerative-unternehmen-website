<section class="newsletter" aria-labelledby="nl-title">
  <div class="wrap newsletter-inner">
    <svg class="nl-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.2"><path d="M6 16h52v34H6z"/><path d="M4 18l28 19 28-19"/></g><g fill="none" stroke="currentColor" stroke-width="1"><circle cx="48" cy="44" r="11"/><circle cx="48" cy="44" r="7"/><circle cx="48" cy="44" r="3.4"/></g><circle cx="48" cy="44" r="1.6" class="nl-core"/></svg>
    <div class="nl-text">
      <h2 class="nl-title" id="nl-title">Neue Beiträge per E-Mail</h2>
      <p>Ein paar Mal im Jahr: neue Texte, Werkzeuge und Termine. Abmeldung jederzeit.</p>
    </div>
    <form class="nl-form" {% if site.newsletter.action %}action="{{ site.newsletter.action }}" method="post"{% else %}data-mailto="{{ site.email }}"{% endif %}>
      <label class="visually-hidden" for="nl-email">E-Mail-Adresse</label>
      <input id="nl-email" type="email" name="{{ site.newsletter.emailField or 'email' }}" required autocomplete="email" placeholder="Ihre E-Mail-Adresse">
      <button class="btn btn--solid" type="submit">Anmelden</button>
      <label class="check"><input type="checkbox" required> <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> zur Kenntnis genommen.</span></label>
    </form>
  </div>
</section>
