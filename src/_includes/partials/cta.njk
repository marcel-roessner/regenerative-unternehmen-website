<section class="cta-block" aria-labelledby="cta-title">
  <div class="wrap cta-grid">
    <div>
      <span class="label">Kontakt</span>
      <h2 class="cta-title" id="cta-title">Schaffen wir gemeinsam die Welt von morgen.</h2>
      <p class="cta-lead">Erzählen Sie uns, wo Ihre Organisation steht. Wir melden uns in der Regel innerhalb weniger Tage.</p>
      <div class="btns">
        <a class="btn btn--solid" href="/kontakt/">Mit uns sprechen</a>
        <a class="btn" href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
    </div>
    <div class="cta-art" aria-hidden="true">{% include "partials/rings.svg" %}</div>
  </div>
</section>
