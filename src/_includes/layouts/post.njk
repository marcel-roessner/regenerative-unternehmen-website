---
layout: layouts/base.njk
---
{%- set topics = tags | topicTags %}
<article>
  <header class="article-head wrap">
    <a class="label" href="/blog/">← Blog</a>
    <h1 class="display" style="margin-top:1.6rem">{{ title }}</h1>
    <div class="meta label">
      <span>{{ author }}</span>
      <time datetime="{{ date | isoDate }}">{{ date | dateDe }}</time>
      <span>{{ content | readingTime }} Min. Lesezeit</span>
    </div>
  </header>
  {%- if image %}
  <figure class="article-hero wrap">
    <img src="{{ image | img }}" alt="" loading="eager" fetchpriority="high">
  </figure>
  {%- endif %}
  <div class="article wrap">
    {{ content | safe }}
  </div>
  <footer class="article-foot wrap">
    <div class="article" style="padding:0">
      <div>
        {%- if topics.length %}
        <span class="label">Themen</span>
        <ul class="chips" style="margin:.8rem 0 3rem">
          {%- for t in topics %}<li><a href="/blog/tags/{{ t | slugTag }}/">{{ t }}</a></li>{% endfor %}
        </ul>
        {%- endif %}
      </div>
    </div>
    {%- set prev = collections.posts | getPreviousCollectionItem(page) %}
    {%- set next = collections.posts | getNextCollectionItem(page) %}
    <nav class="pager" aria-label="Weitere Beiträge">
      <span class="label pager-head">Weiterlesen</span>
      <div class="pager-grid">
        {%- for item in [next, prev] %}{% if item %}
        <a class="pager-item" href="{{ item.url }}">
          <span class="pager-thumb">{% if item.data.image %}<img src="{{ item.data.image | img(true) }}" alt="" loading="lazy">{% endif %}</span>
          <span class="pager-text">
            <span class="label">{{ "Älterer Beitrag" if item == next else "Neuerer Beitrag" }} · {{ item.date | dateDe }}</span>
            <span class="t">{{ item.data.title }}</span>
            <span class="pager-more">Lesen <span aria-hidden="true">→</span></span>
          </span>
        </a>
        {%- endif %}{% endfor %}
      </div>
    </nav>
  </footer>
</article>
{% include "partials/newsletter.njk" %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ title | dump | safe }},"datePublished":"{{ date | isoDate }}","dateModified":"{{ updated }}","author":{"@type":"Person","name":{{ author | dump | safe }}},"image":"{{ site.url }}{{ image | img }}","mainEntityOfPage":"{{ site.url }}{{ page.url }}"}</script>
