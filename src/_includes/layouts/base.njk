<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.title) if title and title != site.title else (site.title + " · " + site.claim) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ (description or site.description) | striptags | truncate(300) }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ (description or site.description) | striptags | truncate(300) }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="de_DE">
  {%- set ogImage = (image | img) if image else "/assets/img/regenerative-unternehmen-vorschau.jpg" %}
  <meta property="og:image" content="{{ site.url }}{{ ogImage }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#f5f5ef">
  {%- if noindex %}<meta name="robots" content="noindex">{% endif %}
  {%- if page.url == "/" %}<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"{{ site.url }}/#org","name":{{ site.title | dump | safe }},"url":"{{ site.url }}/","email":"{{ site.email }}","sameAs":["{{ site.linkedin }}"],"description":{{ site.description | dump | safe }}},{"@type":"WebSite","@id":"{{ site.url }}/#website","url":"{{ site.url }}/","name":{{ site.title | dump | safe }},"inLanguage":"de","publisher":{"@id":"{{ site.url }}/#org"}}]}</script>{% endif %}
  {%- if productIndex is defined %}{% set product = products.items[productIndex] %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ product.title | dump | safe }},"description":{{ description | dump | safe }},"image":"{{ site.url }}{{ product.image | img }}","brand":{"@type":"Organization","name":{{ site.title | dump | safe }}},"offers":{"@type":"Offer","priceCurrency":"EUR","price":"{{ product.price | priceNum }}","availability":"https://schema.org/InStock","url":"{{ site.url }}{{ page.url }}"}}</script>{% endif %}
  {%- if jsonld %}<script type="application/ld+json">{{ jsonld | safe }}</script>{% endif %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Blog-Feed">
  <link rel="preload" href="/assets/fonts/unbounded-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/hanken-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/site.js" defer></script>
  {%- for sc in scripts %}<script src="/assets/js/{{ sc }}.js" defer></script>{% endfor %}
</head>
<body>
  <a class="skip" href="#main">Zum Inhalt springen</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {%- if not hideCta %}{% include "partials/cta.njk" %}{% endif %}
  {% include "partials/footer.njk" %}
</body>
</html>
